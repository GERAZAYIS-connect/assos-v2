# =============================================================================
# ASSOS 2.0 — Environment Variables Template
# Copy this file to .env and fill in real values
# NEVER commit the .env file to git
# =============================================================================

# --- API (NestJS) ---
NODE_ENV=development
API_PORT=4000
API_URL=http://api.lvh.me:4000

# JWT — generate with: openssl genrsa -out private.pem 2048
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Database — Supabase
# Transaction mode (pooler) for normal queries
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for migrations (bypasses pgbouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Redis — Upstash
UPSTASH_REDIS_URL="rediss://:[password]@[endpoint].upstash.io:6380"

# --- WEB (Next.js) ---
NEXT_PUBLIC_API_URL=http://api.lvh.me:4000
NEXTAUTH_URL=http://lvh.me:3000
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# --- FreeMoPay ---
FREEMOPAY_BASE_URL=https://api.freemopay.com/v1
FREEMOPAY_API_KEY=your_freemopay_api_key
FREEMOPAY_API_SECRET=your_freemopay_api_secret
FREEMOPAY_WEBHOOK_SECRET=your_webhook_hmac_secret

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@assos.cm
SMTP_PASS=your_smtp_password
SMTP_FROM="Assos 2.0 <noreply@assos.cm>"

# --- SMS ---
SMS_PROVIDER=termii
SMS_API_KEY=your_sms_api_key

# --- Storage (Supabase Storage) ---
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=assos-documents

# --- Platform ---
PLATFORM_DOMAIN=assos.cm
RESERVED_SLUGS=api,admin,app,support,www,static,assets,auth,webhook
